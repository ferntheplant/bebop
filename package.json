{
  "name": "@bebop/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check",
    "dev": "vp run @bebop/server#dev",
    "ready": "vp run build && vp check && vp run test && vp run test:integration && vp run smoke",
    "smoke": "vp run @bebop/server#smoke && vp run @bebop/swordfish#smoke && vp run @bebop/opencode-plugin#smoke",
    "test": "vp test --run apps packages",
    "test:e2e": "vp test --run --passWithNoTests test/e2e",
    "test:integration": "vp test --run test/integration",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@opencode-ai/plugin": "1.18.5",
    "@opencode-ai/sdk": "1.18.5",
    "@types/bun": "1.3.14",
    "effect": "4.0.0-beta.101",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  }
}
