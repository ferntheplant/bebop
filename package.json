{
  "name": "@bebop/root",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "prototypes/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config"
  },
  "devDependencies": {
    "@bebop/contracts": "workspace:*",
    "@bebop/testkit": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.101",
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@effect/platform-bun": "4.0.0-beta.101",
    "@effect/sql-pg": "4.0.0-beta.101",
    "@effect/sql-sqlite-bun": "4.0.0-beta.101",
    "@opencode-ai/plugin": "1.18.5",
    "@opencode-ai/sdk": "1.18.5",
    "@types/bun": "1.3.14",
    "effect": "4.0.0-beta.101",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  }
}
